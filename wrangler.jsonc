{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shareboard",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "main": "@tanstack/react-start/server-entry",
  "assets": { "directory": ".output/public" },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "SHAREBOARD_R2", "bucket_name": "shareboard" }],
  "ratelimits": [
    { "name": "SHAREBOARD_SHARE_CREATE_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHAREBOARD_SHARE_DELETE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHAREBOARD_UNLOCK_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } },
    { "name": "SHAREBOARD_OG_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 12, "period": 60 } },
    { "name": "SHAREBOARD_HANDOFF_RATE_LIMIT", "namespace_id": "1005", "simple": { "limit": 4, "period": 60 } },
    { "name": "SHAREBOARD_TWEET_RATE_LIMIT", "namespace_id": "1006", "simple": { "limit": 12, "period": 60 } },
    { "name": "SHAREBOARD_OBJECTS_RATE_LIMIT", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } },
    { "name": "SHAREBOARD_PUBLIC_READ_RATE_LIMIT", "namespace_id": "1009", "simple": { "limit": 60, "period": 60 } },
    { "name": "SHAREBOARD_UNLOCK_BOARD_RATE_LIMIT", "namespace_id": "1011", "simple": { "limit": 2, "period": 60 } },
    { "name": "SHAREBOARD_OWNER_RATE_LIMIT", "namespace_id": "1012", "simple": { "limit": 10, "period": 60 } }
  ]
}
